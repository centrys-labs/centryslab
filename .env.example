# Analytics: the script loads only after the visitor accepts the consent banner.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional: only needed for a custom PostHog proxy. Derived from the host by default.
# NEXT_PUBLIC_POSTHOG_ASSETS_HOST=https://us-assets.i.posthog.com

# Newsletter: server-side key, never exposed to the browser.
BUTTONDOWN_API_KEY=

# Project pages read repository READMEs from the GitHub API. Optional: raises
# the unauthenticated rate limit, so builds don't lose a README.
GITHUB_TOKEN=

# Search-engine verification meta tags. Optional.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
